# ---------------------------------------------------------------
# WEATHERLY PRO – environment configuration
# Copy this file to `.env` and fill in the keys you want to use.
# NOTE: these variables have NO `VITE_` prefix on purpose – they are
# read only by the server-side middleware (server/apiMiddleware.js)
# and are never shipped to the browser bundle.
# ---------------------------------------------------------------

# Optional – enables the AI Weather Assistant (Claude by Anthropic).
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional – override the Claude model used by the assistant.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional – enables extra OpenWeatherMap radar layers (clouds, wind,
# precipitation tiles). Free key: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Weather, forecast, air-quality, history and geocoding data come from
# Open-Meteo and precipitation radar from RainViewer – no keys required.
